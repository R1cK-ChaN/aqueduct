# Copy to .env next to start.sh and fill in.

# Set a password for the hlmm database user. Keep it out of git.
CLICKHOUSE_PASSWORD=

# Optional storage paths. The script defaults to data and logs next to the
# env file. Compose defaults to the same directories next to compose.yaml.
# CLICKHOUSE_DATA_DIR=/path/to/clickhouse
# CLICKHOUSE_LOG_DIR=/path/to/clickhouse-logs

# Host ports, bound to 127.0.0.1 only. Change them when another ClickHouse
# already uses the defaults on this machine.
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9000
